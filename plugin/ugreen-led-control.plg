<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "ugreen-led-control">
<!ENTITY author    "Alexander Schubert">
<!ENTITY version   "0.11.0">
<!ENTITY launch    "Settings/UGREENLEDControl">
<!ENTITY repo      "https://raw.githubusercontent.com/alexanderschubert/ugreen-led-control">
<!ENTITY gitURL    "&repo;/v&version;">
<!ENTITY releaseURL "https://github.com/alexanderschubert/ugreen-led-control/releases/download/v&version;">
<!ENTITY pluginURL "&repo;/main/plugin/ugreen-led-control.plg">
<!ENTITY bootDIR   "/boot/config/plugins/&name;">
<!ENTITY srcDIR    "&bootDIR;/&version;">
]>

<PLUGIN
  name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="lightbulb-o"
  min="7.0.0"
  support="https://github.com/alexanderschubert/ugreen-led-control/issues"
>

<CHANGES>

### 0.11.0
- Unraid alerts: while Unraid has unread warnings (or only alerts, as chosen), the power LED blinks in the alert colour; once they are read or archived it returns to normal (System page, checked every minute)

### 0.10.0
- Identify a bay: "Identifizieren" on the Laufwerke page blinks the bay's LED white for 30 seconds, then restores its previous state; the status daemon leaves it alone meanwhile

### 0.9.0
- The interface speaks German and English: System → Sprache / Language, with "Automatic" following Unraid's language

### 0.8.0
- Rainbow effect: a colour wave over the chosen LEDs, with speed and direction
- Temperature effect: the LEDs show the CPU temperature from blue (35 °C) over green and yellow to red (65 °C)
- "Nur im Leerlauf" pauses both while a disk is busy
- Picking a colour or another effect for an LED ends a rainbow/temperature effect on it; in status mode they apply to the power LED only

### 0.7.0
- Night mode (Zeitpläne): from a start to an end time, also across midnight, the LEDs are dimmed to a night brightness or switched off; in status mode disk and network LEDs follow, and dark LEDs don't blink

### 0.6.1
- Status mode is easier to recognise: disk and network LEDs show "Statusmodus" instead of a greyed-out effect field, and the LED and Laufwerke pages explain what the mode does

### 0.6.0
- No kernel module any more: the plugin talks to the LED controller itself (ugreen-led-i2c over /dev/i2c-N), so Unraid updates with a new kernel keep the LEDs working
- Status mode blinks disks and the network LED with the controller's own blink while there is activity
- A led_ugreen driver from an older version is unloaded; its cached copy on the boot device is removed

### 0.5.1
- Fix: without ugreenleds-driver no LEDs appeared, because the LED controller was never declared on the SMBus; the plugin now does that itself
- The System page shows whether the LED controller is really declared and which LEDs were found, instead of fixed values

### 0.5.0
- Status mode: disk LEDs blink on activity and switch to the error colour when Unraid reports a disabled, invalid or missing disk; empty bays stay dark; the network LED blinks with traffic and turns to the error colour without link or gateway
- Bays are matched to disks by SATA port (DXP6800 Pro), shown on the Laufwerke page
- The status daemon steps aside while the ugreenleds-driver monitor is running

### 0.4.0
- Settings made in the web interface are saved on the boot device (USB flash drive or SSD) and restored at boot

### 0.3.0
- New interface: overview with general settings, LED colours, effects, live preview of the case and effect settings
- Per-LED page and per-bay page with colour, brightness and effect
- Test button and reset to defaults
- Warning while the ugreenleds-driver LED monitor is running, because it overwrites disk and network LEDs
- Styles only apply inside the plugin page

### 0.2.1
- Fix: the install script copied nothing, because plugin entities are not expanded inside CDATA

### 0.2.0
- Plugin downloads its files from GitHub instead of expecting them on the flash drive
- LED writes from the settings page work (they go through api.php with the WebGUI csrf_token)
- Only the bays the model really has are shown (DXP6800 Pro: 6)
- Reading an LED returns valid JSON again
- An led_ugreen driver loaded by another plugin is left alone
- Success and error messages are visible
- The page lives at Settings → User Utilities → UGREEN LED Control

### 0.1.0
- Initial release

</CHANGES>

<!-- Plugin files, cached on the boot device (/boot: USB flash drive or SSD) per version so a reboot needs no network -->

<FILE Name="&srcDIR;/backend/ugreen-led-ctl">
<URL>&gitURL;/src/backend/ugreen-led-ctl</URL>
</FILE>

<!-- Static binary built by the "Tag release" workflow and attached to the release -->
<FILE Name="&srcDIR;/backend/ugreen-led-i2c">
<URL>&releaseURL;/ugreen-led-i2c</URL>
</FILE>

<FILE Name="&srcDIR;/api.php">
<URL>&gitURL;/src/web/api.php</URL>
</FILE>

<FILE Name="&srcDIR;/UGREENLEDControl.page">
<URL>&gitURL;/src/web/UGREENLEDControl.page</URL>
</FILE>

<FILE Name="&srcDIR;/css/app.css">
<URL>&gitURL;/src/web/css/app.css</URL>
</FILE>

<FILE Name="&srcDIR;/js/i18n.js">
<URL>&gitURL;/src/web/js/i18n.js</URL>
</FILE>

<FILE Name="&srcDIR;/js/app.js">
<URL>&gitURL;/src/web/js/app.js</URL>
</FILE>

<!-- ========================================================= -->
<!-- INSTALL -->
<!-- ========================================================= -->

<!-- Entities are not expanded inside CDATA, so the scripts get them as variables first. -->
<FILE Run="/bin/bash">
<INLINE>
NAME="&name;"
VERSION="&version;"
GIT_URL="&gitURL;"
BOOT_DIR="&bootDIR;"
SRC_DIR="&srcDIR;"
<![CDATA[

PLUGIN_DIR="/usr/local/emhttp/plugins/${NAME}"
KERNEL="$(uname -r)"

log() {
    echo "[UGREEN LED Control] $1"
}

log "Installing ${VERSION} on kernel ${KERNEL}"

#
# Hardware access: /dev/i2c-N, no kernel module.
#

# The status daemon and an effect of the previous version must not keep writing during the update.
if [ -x "${PLUGIN_DIR}/backend/ugreen-led-ctl" ]; then
    "${PLUGIN_DIR}/backend/ugreen-led-ctl" fx stop >/dev/null 2>&1
    "${PLUGIN_DIR}/backend/ugreen-led-ctl" daemon stop >/dev/null 2>&1
fi

modprobe i2c-dev

# Versions up to 0.5.1 used the led_ugreen kernel module; it would hold address 0x3a.
if grep -q '^led_ugreen ' /proc/modules; then
    for device in /sys/bus/i2c/devices/*-003a; do
        [ -e "${device}" ] || continue
        echo 0x3a > "$(dirname "$(readlink -f "${device}")")/delete_device"
    done
    rmmod led_ugreen 2>/dev/null && log "Unloaded led_ugreen (no longer needed)."
fi
rm -rf "${BOOT_DIR}/driver" "${BOOT_DIR}/driver-state"

#
# Web interface
#

rm -rf "${PLUGIN_DIR}"
mkdir -p "${PLUGIN_DIR}"
cp -r "${SRC_DIR}/." "${PLUGIN_DIR}/"
chmod 755 "${PLUGIN_DIR}/backend/ugreen-led-ctl" "${PLUGIN_DIR}/backend/ugreen-led-i2c"

#
# Restore the LED settings saved by the web interface (this also runs at boot)
#

if "${PLUGIN_DIR}/backend/ugreen-led-i2c" probe >/dev/null 2>&1; then
    "${PLUGIN_DIR}/backend/ugreen-led-ctl" apply | sed 's/^/[UGREEN LED Control] /'

    # Restart also replaces a daemon still running the previous version's code.
    if grep -qx 'mode="status"' "${BOOT_DIR}/leds.cfg" 2>/dev/null; then
        "${PLUGIN_DIR}/backend/ugreen-led-ctl" daemon restart 2>&1 | sed 's/^/[UGREEN LED Control] /'
    fi

    # Night mode right away; afterwards cron checks it every minute.
    "${PLUGIN_DIR}/backend/ugreen-led-ctl" schedule --force

    # Rainbow/temperature effect, if one was chosen.
    if grep -q '^fx_name="[a-z]' "${BOOT_DIR}/leds.cfg" 2>/dev/null; then
        "${PLUGIN_DIR}/backend/ugreen-led-ctl" fx start 2>&1 | sed 's/^/[UGREEN LED Control] /'
    fi
else
    log "WARNING: The LED controller does not answer on the SMBus; no LEDs available."
fi

#
# Night mode schedule: Unraid's update_cron merges /boot/config/plugins/*/*.cron
#

echo "* * * * * ${PLUGIN_DIR}/backend/ugreen-led-ctl schedule >/dev/null 2>&1" > "${BOOT_DIR}/${NAME}.cron"
/usr/local/sbin/update_cron

#
# Drop cached files of older versions
#

for dir in "${BOOT_DIR}"/*/; do
    case "$(basename "${dir}")" in
        "${VERSION}") ;;
        *) rm -rf "${dir}" ;;
    esac
done

log "Installation complete."

]]>
</INLINE>
</FILE>

<!-- ========================================================= -->
<!-- REMOVE -->
<!-- ========================================================= -->

<FILE Run="/bin/bash" Method="remove">
<INLINE>
NAME="&name;"
BOOT_DIR="&bootDIR;"
<![CDATA[

PLUGIN_DIR="/usr/local/emhttp/plugins/${NAME}"
KERNEL="$(uname -r)"

log() {
    echo "[UGREEN LED Control] $1"
}

if [ -x "${PLUGIN_DIR}/backend/ugreen-led-ctl" ]; then
    "${PLUGIN_DIR}/backend/ugreen-led-ctl" fx stop >/dev/null 2>&1
    "${PLUGIN_DIR}/backend/ugreen-led-ctl" daemon stop >/dev/null 2>&1
fi

rm -rf "${PLUGIN_DIR}"

rm -rf "${BOOT_DIR}"
/usr/local/sbin/update_cron

log "Removed."

]]>
</INLINE>
</FILE>

</PLUGIN>
