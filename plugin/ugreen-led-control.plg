<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "ugreen-led-control">
<!ENTITY author    "Alexander Schubert">
<!ENTITY version   "0.5.1">
<!ENTITY launch    "Settings/UGREENLEDControl">
<!ENTITY repo      "https://raw.githubusercontent.com/alexanderschubert/ugreen-led-control">
<!ENTITY gitURL    "&repo;/v&version;">
<!ENTITY pluginURL "&repo;/main/plugin/ugreen-led-control.plg">
<!ENTITY bootDIR   "/boot/config/plugins/&name;">
<!ENTITY srcDIR    "&bootDIR;/&version;">
]>

<PLUGIN
  name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="lightbulb-o"
  min="7.0.0"
  support="https://github.com/alexanderschubert/ugreen-led-control/issues"
>

<CHANGES>

### 0.5.1
- Fix: without ugreenleds-driver no LEDs appeared, because the LED controller was never declared on the SMBus; the plugin now does that itself

### 0.5.0
- Status mode: disk LEDs blink on activity and switch to the error colour when Unraid reports a disabled, invalid or missing disk; empty bays stay dark; the network LED blinks with traffic and turns to the error colour without link or gateway
- Bays are matched to disks by SATA port (DXP6800 Pro), shown on the Laufwerke page
- The status daemon steps aside while the ugreenleds-driver monitor is running

### 0.4.0
- Settings made in the web interface are saved on the boot device (USB flash drive or SSD) and restored at boot

### 0.3.0
- New interface: overview with general settings, LED colours, effects, live preview of the case and effect settings
- Per-LED page and per-bay page with colour, brightness and effect
- Test button and reset to defaults
- Warning while the ugreenleds-driver LED monitor is running, because it overwrites disk and network LEDs
- Styles only apply inside the plugin page

### 0.2.1
- Fix: the install script copied nothing, because plugin entities are not expanded inside CDATA

### 0.2.0
- Plugin downloads its files from GitHub instead of expecting them on the flash drive
- LED writes from the settings page work (they go through api.php with the WebGUI csrf_token)
- Only the bays the model really has are shown (DXP6800 Pro: 6)
- Reading an LED returns valid JSON again
- An led_ugreen driver loaded by another plugin is left alone
- Success and error messages are visible
- The page lives at Settings → User Utilities → UGREEN LED Control

### 0.1.0
- Initial release

</CHANGES>

<!-- Plugin files, cached on the boot device (/boot: USB flash drive or SSD) per version so a reboot needs no network -->

<FILE Name="&srcDIR;/backend/ugreen-led-ctl">
<URL>&gitURL;/src/backend/ugreen-led-ctl</URL>
</FILE>

<FILE Name="&srcDIR;/api.php">
<URL>&gitURL;/src/web/api.php</URL>
</FILE>

<FILE Name="&srcDIR;/UGREENLEDControl.page">
<URL>&gitURL;/src/web/UGREENLEDControl.page</URL>
</FILE>

<FILE Name="&srcDIR;/css/app.css">
<URL>&gitURL;/src/web/css/app.css</URL>
</FILE>

<FILE Name="&srcDIR;/js/app.js">
<URL>&gitURL;/src/web/js/app.js</URL>
</FILE>

<!-- ========================================================= -->
<!-- INSTALL -->
<!-- ========================================================= -->

<!-- Entities are not expanded inside CDATA, so the scripts get them as variables first. -->
<FILE Run="/bin/bash">
<INLINE>
NAME="&name;"
VERSION="&version;"
GIT_URL="&gitURL;"
BOOT_DIR="&bootDIR;"
SRC_DIR="&srcDIR;"
<![CDATA[

PLUGIN_DIR="/usr/local/emhttp/plugins/${NAME}"
KERNEL="$(uname -r)"

log() {
    echo "[UGREEN LED Control] $1"
}

log "Installing ${VERSION} on kernel ${KERNEL}"

#
# Driver
#
# Another plugin (e.g. ich777's ugreenleds-driver) may already provide
# led_ugreen. Then we only use it and never touch it.
#

DRIVER_CACHE="${BOOT_DIR}/driver/${KERNEL}/led-ugreen.ko.xz"
DRIVER_TARGET="/lib/modules/${KERNEL}/extra/led-ugreen.ko.xz"

if lsmod | grep -q '^led_ugreen '; then

    log "led_ugreen is already loaded, using it."

elif modinfo led_ugreen >/dev/null 2>&1; then

    log "led_ugreen is installed, loading it."
    modprobe led_ugreen

else

    if [ ! -f "${DRIVER_CACHE}" ]; then
        log "Downloading led_ugreen for ${KERNEL}..."
        mkdir -p "$(dirname "${DRIVER_CACHE}")"
        if ! curl -fsSL -o "${DRIVER_CACHE}" \
            "${GIT_URL}/driver/packages/${KERNEL}/led-ugreen.ko.xz"; then
            rm -f "${DRIVER_CACHE}"
            log "WARNING: No led_ugreen build for kernel ${KERNEL}."
            log "WARNING: LED control is unavailable until a matching driver exists."
        fi
    fi

    if [ -f "${DRIVER_CACHE}" ]; then
        mkdir -p "$(dirname "${DRIVER_TARGET}")"
        cp "${DRIVER_CACHE}" "${DRIVER_TARGET}"
        chmod 644 "${DRIVER_TARGET}"
        depmod -a "${KERNEL}"
        if modprobe led_ugreen; then
            echo "installed_by=${NAME}" > "${BOOT_DIR}/driver-state"
            echo "kernel=${KERNEL}" >> "${BOOT_DIR}/driver-state"
            log "led_ugreen loaded."
        else
            log "WARNING: led_ugreen could not be loaded."
        fi
    fi

fi

#
# led_ugreen only creates the LEDs once the controller (0x3a) is declared
# on the SMBus adapter. ugreenleds-driver used to do this for us.
#

if lsmod | grep -q '^led_ugreen ' && ! ls -d /sys/bus/i2c/devices/*-003a >/dev/null 2>&1; then
    for adapter in /sys/bus/i2c/devices/i2c-*; do
        if grep -q 'SMBus I801' "${adapter}/name" 2>/dev/null; then
            echo "led-ugreen 0x3a" > "${adapter}/new_device" \
                && log "LED controller declared on ${adapter##*/}."
            break
        fi
    done

    ls -d /sys/bus/i2c/devices/*-003a >/dev/null 2>&1 \
        || log "WARNING: LED controller 0x3a could not be declared; no LEDs available."
fi

#
# Web interface
#

rm -rf "${PLUGIN_DIR}"
mkdir -p "${PLUGIN_DIR}"
cp -r "${SRC_DIR}/." "${PLUGIN_DIR}/"
chmod 755 "${PLUGIN_DIR}/backend/ugreen-led-ctl"

#
# Restore the LED settings saved by the web interface (this also runs at boot)
#

if lsmod | grep -q '^led_ugreen '; then
    "${PLUGIN_DIR}/backend/ugreen-led-ctl" apply | sed 's/^/[UGREEN LED Control] /'

    # Restart also replaces a daemon still running the previous version's code.
    if grep -qx 'mode="status"' "${BOOT_DIR}/leds.cfg" 2>/dev/null; then
        "${PLUGIN_DIR}/backend/ugreen-led-ctl" daemon restart 2>&1 | sed 's/^/[UGREEN LED Control] /'
    fi
fi

#
# Drop cached files of older versions
#

for dir in "${BOOT_DIR}"/*/; do
    case "$(basename "${dir}")" in
        "${VERSION}"|driver) ;;
        *) rm -rf "${dir}" ;;
    esac
done

log "Installation complete."

]]>
</INLINE>
</FILE>

<!-- ========================================================= -->
<!-- REMOVE -->
<!-- ========================================================= -->

<FILE Run="/bin/bash" Method="remove">
<INLINE>
NAME="&name;"
BOOT_DIR="&bootDIR;"
<![CDATA[

PLUGIN_DIR="/usr/local/emhttp/plugins/${NAME}"
KERNEL="$(uname -r)"

log() {
    echo "[UGREEN LED Control] $1"
}

if [ -x "${PLUGIN_DIR}/backend/ugreen-led-ctl" ]; then
    "${PLUGIN_DIR}/backend/ugreen-led-ctl" daemon stop >/dev/null 2>&1
fi

rm -rf "${PLUGIN_DIR}"

# Remove the driver only if this plugin installed it.
if grep -q "^installed_by=${NAME}\$" "${BOOT_DIR}/driver-state" 2>/dev/null; then
    log "Removing led_ugreen installed by this plugin."
    modprobe -r led_ugreen 2>/dev/null
    rm -f "/lib/modules/${KERNEL}/extra/led-ugreen.ko.xz"
    depmod -a "${KERNEL}"
else
    log "led_ugreen was not installed by this plugin, leaving it."
fi

rm -rf "${BOOT_DIR}"

log "Removed."

]]>
</INLINE>
</FILE>

</PLUGIN>
