#!/bin/bash
#
# UGREEN LED Control
# Backend for UGREEN NAS LED Class driver
#

set -u

LED_BASE="${UGREEN_LED_BASE:-/sys/class/leds}"
CONFIG="${UGREEN_LED_CONFIG:-/boot/config/plugins/ugreen-led-control/leds.cfg}"
DISKS_INI="${UGREEN_DISKS_INI:-/var/local/emhttp/disks.ini}"
SYS_BLOCK="${UGREEN_SYS_BLOCK:-/sys/block}"
SYS_NET="${UGREEN_SYS_NET:-/sys/class/net}"
PIDFILE="/var/run/ugreen-led-control.pid"

DEFAULT_DISK_COLOR="255 160 0"
DEFAULT_ERROR_COLOR="255 59 48"

# The driver always creates disk1..disk8; only the bays the model has are real.
product_name() {
    [ -n "${UGREEN_PRODUCT:-}" ] && { echo "$UGREEN_PRODUCT"; return; }
    cat /sys/class/dmi/id/product_name 2>/dev/null || echo "UGREEN NAS"
}

# DXP6800 Pro -> 6, DX4600 Pro -> 4, DXP8800 Plus -> 8
bay_count() {
    local digit
    digit="$(product_name | sed -n 's/^DXP\{0,1\}\([2-8]\)[0-9]\{3\}.*/\1/p')"
    echo "${digit:-8}"
}

supported_leds() {
    local i
    printf 'power netdev'
    for i in $(seq 1 "$(bay_count)"); do
        printf ' disk%s' "$i"
    done
}

usage() {
    cat <<USAGE
UGREEN LED Control

Usage:
  ugreen-led-ctl status
  ugreen-led-ctl list
  ugreen-led-ctl get <led>
  ugreen-led-ctl all
  ugreen-led-ctl apply        (restore the settings saved by the web UI)
  ugreen-led-ctl bays         (which disk sits in which bay)
  ugreen-led-ctl daemon start|stop|restart|status|run
  ugreen-led-ctl on <led>
  ugreen-led-ctl off <led>
  ugreen-led-ctl brightness <led> <0-255>
  ugreen-led-ctl color <led> <R> <G> <B>
  ugreen-led-ctl blink <led> <on_ms> <off_ms>
  ugreen-led-ctl breath <led> <on_ms> <off_ms>
  ugreen-led-ctl stop <led>
  ugreen-led-ctl trigger <led> <trigger>
  ugreen-led-ctl help

Supported LEDs:
  power
  netdev
  disk1 ... diskN (N = number of bays)
USAGE
}

valid_led() {
    local led="$1"
    [ -d "$LED_BASE/$led" ]
}

read_attr() {
    local led="$1"
    local attr="$2"
    local file="$LED_BASE/$led/$attr"

    if [ -r "$file" ]; then
        head -n 1 "$file" 2>/dev/null
    else
        echo ""
    fi
}

# blink_type and trigger list every option and mark the active one: "[none] blink breath"
read_selected() {
    read_attr "$1" "$2" | sed -n 's/.*\[\([^]]*\)\].*/\1/p'
}

write_attr() {
    local led="$1"
    local attr="$2"
    local value="$3"
    local file="$LED_BASE/$led/$attr"

    if [ ! -e "$file" ]; then
        echo "ERROR: Attribute '$attr' is not available for '$led'." >&2
        return 1
    fi

    if [ ! -w "$file" ]; then
        echo "ERROR: Attribute '$attr' is not writable for '$led'." >&2
        return 1
    fi

    printf '%s\n' "$value" > "$file"
}

list_leds() {
    echo "["

    local first=1
    local led

    for led in $(supported_leds); do
        if valid_led "$led"; then
            if [ "$first" -eq 0 ]; then
                echo ","
            fi

            printf '  "%s"' "$led"
            first=0
        fi
    done

    echo
    echo "]"
}

get_status() {
    local led="$1"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    local brightness
    local max_brightness
    local color
    local effect
    local trigger

    brightness="$(read_attr "$led" brightness)"
    max_brightness="$(read_attr "$led" max_brightness)"
    color="$(read_attr "$led" color)"
    effect="$(read_selected "$led" blink_type)"
    trigger="$(read_selected "$led" trigger)"

    printf '{\n'
    printf '  "name": "%s",\n' "$led"
    printf '  "brightness": "%s",\n' "$brightness"
    printf '  "max_brightness": "%s",\n' "$max_brightness"
    printf '  "color": "%s",\n' "$color"
    printf '  "effect": "%s",\n' "${effect:-none}"
    printf '  "trigger": "%s"\n' "${trigger:-none}"
    printf '}\n'
}

# ich777's ugreenleds-driver monitor rewrites the disk and netdev LEDs.
foreign_monitor_running() {
    pgrep -f '^/bin/bash /usr/bin/ugreen-leds' >/dev/null 2>&1
}

all_leds() {
    local first=1
    local led

    printf '{\n'
    for led in $(supported_leds); do
        valid_led "$led" || continue
        [ "$first" -eq 1 ] || printf ',\n'
        printf '"%s": ' "$led"
        get_status "$led"
        first=0
    done
    printf '}\n'
}

status() {
    local device

    printf '{\n'
    printf '  "ok": true,\n'
    if foreign_monitor_running; then
        printf '  "foreign_monitor": true,\n'
    else
        printf '  "foreign_monitor": false,\n'
    fi
    printf '  "model": "%s",\n' "$(product_name)"
    printf '  "bays": %s,\n' "$(bay_count)"
    printf '  "kernel": "%s",\n' "$(uname -r)"
    printf '  "mode": "%s",\n' "$(config_value mode | grep -x status || echo manual)"
    if daemon_running; then
        printf '  "daemon": true,\n'
    else
        printf '  "daemon": false,\n'
    fi
    printf '  "disk_error_color": "%s",\n' "$(config_value disk_error_color | grep . || echo "$DEFAULT_ERROR_COLOR")"
    printf '  "network_device": "%s",\n' "$(network_device)"
    printf '  "controller": "led_ugreen",\n'
    # The real device, e.g. /sys/bus/i2c/devices/0-003a; empty while it isn't declared.
    device="$(ls -d /sys/bus/i2c/devices/*-003a 2>/dev/null | head -n 1)"
    if [ -n "$device" ]; then
        device="${device##*/}"
        printf '  "i2c_bus": %s,\n' "${device%%-*}"
        printf '  "i2c_address": "0x3a",\n'
    else
        printf '  "i2c_bus": null,\n'
        printf '  "i2c_address": null,\n'
    fi
    printf '  "leds": '

    list_leds

    printf '}\n'
}

set_on() {
    local led="$1"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" trigger "none" 2>/dev/null || true
    write_attr "$led" brightness 255
}

set_off() {
    local led="$1"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" trigger "none" 2>/dev/null || true
    write_attr "$led" brightness 0
}

set_brightness() {
    local led="$1"
    local value="$2"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    case "$value" in
        ''|*[!0-9]*)
            echo "ERROR: Brightness must be between 0 and 255." >&2
            return 1
            ;;
    esac

    if [ "$value" -gt 255 ]; then
        echo "ERROR: Brightness must be between 0 and 255." >&2
        return 1
    fi

    write_attr "$led" trigger "none" 2>/dev/null || true
    write_attr "$led" brightness "$value"
}

set_color() {
    local led="$1"
    local r="$2"
    local g="$3"
    local b="$4"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    for value in "$r" "$g" "$b"; do
        case "$value" in
            ''|*[!0-9]*)
                echo "ERROR: RGB values must be between 0 and 255." >&2
                return 1
                ;;
        esac

        if [ "$value" -gt 255 ]; then
            echo "ERROR: RGB values must be between 0 and 255." >&2
            return 1
        fi
    done

    write_attr "$led" color "$r $g $b"
}

set_blink() {
    local led="$1"
    local on_ms="$2"
    local off_ms="$3"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" trigger "none" 2>/dev/null || true
    write_attr "$led" blink_type "blink $on_ms $off_ms"
}

set_breath() {
    local led="$1"
    local on_ms="$2"
    local off_ms="$3"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" trigger "none" 2>/dev/null || true
    write_attr "$led" blink_type "breath $on_ms $off_ms"
}

stop_effect() {
    local led="$1"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" blink_type "none" 2>/dev/null || true
    write_attr "$led" trigger "none" 2>/dev/null || true
}

# Read one value from the settings file without sourcing it: key="value"
config_value() {
    sed -n "s/^$1=\"\(.*\)\"\$/\1/p" "$CONFIG" 2>/dev/null | tail -n 1
}

apply_config() {
    local led
    local color
    local brightness
    local effect
    local on_ms
    local off_ms

    if [ ! -f "$CONFIG" ]; then
        echo "No saved settings ($CONFIG)."
        return 0
    fi

    for led in $(supported_leds); do
        valid_led "$led" || continue

        color="$(config_value "${led}_color")"
        brightness="$(config_value "${led}_brightness")"
        effect="$(config_value "${led}_effect")"
        on_ms="$(config_value "${led}_on")"
        off_ms="$(config_value "${led}_off")"

        # shellcheck disable=SC2086 # "R G B" is meant to split into three arguments
        [ -n "$color" ] && set_color "$led" $color

        # Brightness first: it resets the trigger, and an effect needs a lit LED.
        [ -n "$brightness" ] && set_brightness "$led" "$brightness"

        case "$effect" in
            blink) set_blink "$led" "${on_ms:-450}" "${off_ms:-450}" ;;
            breath) set_breath "$led" "${on_ms:-1200}" "${off_ms:-900}" ;;
            none) stop_effect "$led" ;;
        esac
    done

    echo "Saved settings applied."
}

set_trigger() {
    local led="$1"
    local trigger="$2"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" trigger "$trigger"
}

# ============================================================
# Status mode: bays, disk activity/health and network
# ============================================================

# SATA port of each bay, left to right. DXP6800 Pro verified against disk serials.
bay_ports() {
    case "$(product_name)" in
        "DXP6800 Pro") echo "ata3 ata4 ata5 ata6 ata1 ata2" ;;
    esac
}

disk_serial() {
    udevadm info -q property -n "/dev/$1" 2>/dev/null | sed -n 's/^ID_SERIAL_SHORT=//p'
}

# Block device (sdX) in a bay. A saved bay<N>_serial wins over the port table.
bay_device() {
    local bay="$1"
    local serial
    local port
    local dev

    serial="$(config_value "bay${bay}_serial")"
    # shellcheck disable=SC2046
    set -- $(bay_ports)
    eval "port=\${$bay:-}"

    for dev in "$SYS_BLOCK"/sd*; do
        [ -e "$dev" ] || continue

        if [ -n "$serial" ]; then
            [ "$(disk_serial "${dev##*/}")" = "$serial" ] && { echo "${dev##*/}"; return; }
        elif [ -n "$port" ]; then
            case "$(readlink -f "$dev/device")" in
                */"$port"/*) echo "${dev##*/}"; return ;;
            esac
        fi
    done
}

# Unraid's view of a device: "<slot> <status>", e.g. "disk2 DISK_OK".
unraid_disk() {
    awk -F'"' -v dev="$1" '
        /^\[/ { name = ""; device = ""; status = "" }
        /^name=/ { name = $2 }
        /^device=/ { device = $2 }
        /^status=/ { status = $2 }
        device == dev && status != "" { print name, status; exit }
    ' "$DISKS_INI" 2>/dev/null
}

is_error_status() {
    case "$1" in
        DISK_INVALID|DISK_DSBL|DISK_DSBL_NEW|DISK_WRONG|DISK_NP_MISSING) return 0 ;;
    esac
    return 1
}

bays_json() {
    local bay
    local dev
    local serial
    local slot
    local disk_status
    local first=1

    printf '['
    for bay in $(seq 1 "$(bay_count)"); do
        dev="$(bay_device "$bay")"
        serial=""
        slot=""
        disk_status=""

        if [ -n "$dev" ]; then
            serial="$(disk_serial "$dev")"
            # shellcheck disable=SC2046
            set -- $(unraid_disk "$dev")
            slot="${1:-}"
            disk_status="${2:-}"
        fi

        [ "$first" -eq 1 ] || printf ','
        printf '{"bay":%s,"led":"disk%s","device":"%s","serial":"%s","slot":"%s","status":"%s","error":%s}' \
            "$bay" "$bay" "$dev" "$serial" "$slot" "$disk_status" \
            "$(is_error_status "$disk_status" && echo true || echo false)"
        first=0
    done
    printf ']\n'
}

# The interface behind the default route; a bridge is resolved to its uplink (e.g. br0 -> bond0).
network_device() {
    local dev
    local port

    dev="$(ip route show default 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1)"

    if [ -n "$dev" ] && [ -d "$SYS_NET/$dev/brif" ]; then
        for port in "$SYS_NET/$dev/brif"/*; do
            case "${port##*/}" in
                veth*|vnet*|tap*|docker*|virbr*|\*) ;;
                *) dev="${port##*/}"; break ;;
            esac
        done
    fi

    echo "$dev"
}

network_ok() {
    local dev="$1"
    local gateway

    [ "$(cat "$SYS_NET/$dev/operstate" 2>/dev/null)" = "up" ] || return 1

    gateway="$(ip route show default 2>/dev/null | sed -n 's/^default via \([^ ]*\).*/\1/p' | head -n 1)"
    [ -z "$gateway" ] || ping -c 1 -W 2 "$gateway" >/dev/null 2>&1
}

log() {
    logger -t ugreen-led-control "$1" 2>/dev/null || echo "$1"
}

# Saved per-LED colour/brightness, with the status-mode defaults.
saved_color() {
    config_value "${1}_color" | grep . || echo "$2"
}

saved_brightness() {
    config_value "${1}_brightness" | grep . || echo 255
}

# Lit LED that the oneshot trigger blinks off briefly on every "shot".
setup_activity_led() {
    local led="$1"
    local color="$2"
    local brightness="$3"

    # shellcheck disable=SC2086
    set_color "$led" $color >/dev/null
    write_attr "$led" blink_type "none" 2>/dev/null
    write_attr "$led" trigger "oneshot" 2>/dev/null
    write_attr "$led" invert 1 2>/dev/null
    write_attr "$led" delay_on 60 2>/dev/null
    write_attr "$led" delay_off 60 2>/dev/null
    # After the trigger: invert switches to full brightness, this sets the real one.
    write_attr "$led" brightness "$brightness" 2>/dev/null
}

setup_network_led() {
    local dev="$1"
    local color="$2"
    local brightness="$3"

    # shellcheck disable=SC2086
    set_color netdev $color >/dev/null
    write_attr netdev blink_type "none" 2>/dev/null
    write_attr netdev trigger "netdev" 2>/dev/null
    write_attr netdev device_name "$dev" 2>/dev/null
    write_attr netdev link 1 2>/dev/null
    write_attr netdev rx 1 2>/dev/null
    write_attr netdev tx 1 2>/dev/null
    write_attr netdev brightness "$brightness" 2>/dev/null
}

daemon_run() {
    local bays
    local tick=0
    local bay
    local dev
    local reads
    local writes
    local rest
    local wanted
    local net_dev
    local net_wanted=""
    local net_ok=1
    local error_color
    local -a devices=()
    local -a applied=()
    local -a counters=()

    bays="$(bay_count)"
    net_dev="$(network_device)"

    trap 'log "status daemon stopped"; exit 0' TERM INT
    log "status daemon started (bays: $bays, network: ${net_dev:-none})"

    while :; do
        # Every 5 s: which disk is where, Unraid's disk status, saved colours.
        if [ $((tick % 25)) -eq 0 ]; then
            # Two monitors would overwrite each other forever; leave the LEDs to the other one.
            if foreign_monitor_running; then
                log "ugreenleds-driver monitor is running, status daemon exits"
                rm -f "$PIDFILE"
                exit 0
            fi

            error_color="$(config_value disk_error_color | grep . || echo "$DEFAULT_ERROR_COLOR")"

            for bay in $(seq 1 "$bays"); do
                valid_led "disk$bay" || continue

                dev="$(bay_device "$bay")"
                devices[bay]="$dev"

                if [ -z "$dev" ]; then
                    wanted="empty"
                else
                    # shellcheck disable=SC2046
                    set -- $(unraid_disk "$dev")
                    if is_error_status "${2:-}"; then
                        wanted="$error_color|$(saved_brightness "disk$bay")"
                    else
                        wanted="$(saved_color "disk$bay" "$DEFAULT_DISK_COLOR")|$(saved_brightness "disk$bay")"
                    fi
                fi

                # A manual write (test, effect) replaces the trigger; set it up again.
                if [ "$wanted" != "empty" ] && [ "$(read_selected "disk$bay" trigger)" != "oneshot" ]; then
                    applied[bay]=""
                fi

                if [ "${applied[bay]:-}" != "$wanted" ]; then
                    if [ "$wanted" = "empty" ]; then
                        write_attr "disk$bay" trigger "none" 2>/dev/null
                        write_attr "disk$bay" brightness 0 2>/dev/null
                    else
                        setup_activity_led "disk$bay" "${wanted%|*}" "${wanted#*|}"
                    fi
                    applied[bay]="$wanted"
                    counters[bay]=""
                fi
            done
        fi

        # Network: link and gateway every 30 s, the LED setup checked every 5 s.
        if [ $((tick % 150)) -eq 0 ] && [ -n "$net_dev" ]; then
            if network_ok "$net_dev"; then
                net_ok=1
            else
                net_ok=0
            fi
        fi

        if [ $((tick % 25)) -eq 0 ] && [ -n "$net_dev" ] && valid_led netdev; then
            if [ "$net_ok" -eq 1 ]; then
                wanted="$(saved_color netdev "0 200 83")|$(saved_brightness netdev)"
            else
                wanted="$error_color|$(saved_brightness netdev)"
            fi

            [ "$(read_selected netdev trigger)" = "netdev" ] || net_wanted=""

            if [ "$net_wanted" != "$wanted" ]; then
                setup_network_led "$net_dev" "${wanted%|*}" "${wanted#*|}"
                net_wanted="$wanted"
            fi
        fi

        # Every 0.2 s: blink a bay whose read/write counters moved.
        for bay in $(seq 1 "$bays"); do
            dev="${devices[bay]:-}"
            [ -n "$dev" ] || continue

            read -r reads _ _ _ writes rest < "$SYS_BLOCK/$dev/stat" 2>/dev/null || continue

            if [ "${counters[bay]:-}" != "$reads $writes" ]; then
                [ -n "${counters[bay]:-}" ] && echo 1 > "$LED_BASE/disk$bay/shot" 2>/dev/null
                counters[bay]="$reads $writes"
            fi
        done

        sleep 0.2
        tick=$((tick + 1))
    done
}

daemon_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

daemon_start() {
    if daemon_running; then
        echo "Status daemon is already running."
        return 0
    fi

    if foreign_monitor_running; then
        echo "ERROR: The LED monitor of ugreenleds-driver is running; uninstall that plugin first." >&2
        return 1
    fi

    setsid "$(readlink -f "$0")" daemon run </dev/null >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    echo "Status daemon started."
}

daemon_stop() {
    local led

    if daemon_running; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
    fi
    rm -f "$PIDFILE"

    # Hand the LEDs back to the saved manual settings.
    for led in $(supported_leds); do
        write_attr "$led" trigger "none" 2>/dev/null
    done
    apply_config >/dev/null

    echo "Status daemon stopped."
}

daemon_command() {
    case "${1:-status}" in
        start) daemon_start ;;
        stop) daemon_stop ;;
        restart) daemon_stop >/dev/null; daemon_start ;;
        run) daemon_run ;;
        status)
            if daemon_running; then
                echo "running (pid $(cat "$PIDFILE"))"
            else
                echo "stopped"
                return 3
            fi
            ;;
        *) echo "Usage: $0 daemon start|stop|restart|status|run" >&2; return 2 ;;
    esac
}

case "${1:-help}" in

    status)
        status
        ;;

    list)
        list_leds
        ;;

    all)
        all_leds
        ;;

    apply)
        apply_config
        ;;

    bays)
        bays_json
        ;;

    daemon)
        daemon_command "${2:-status}"
        ;;

    get)
        [ $# -eq 2 ] || {
            echo "Usage: $0 get <led>" >&2
            exit 2
        }

        get_status "$2"
        ;;

    on)
        [ $# -eq 2 ] || {
            echo "Usage: $0 on <led>" >&2
            exit 2
        }

        set_on "$2"
        ;;

    off)
        [ $# -eq 2 ] || {
            echo "Usage: $0 off <led>" >&2
            exit 2
        }

        set_off "$2"
        ;;

    brightness)
        [ $# -eq 3 ] || {
            echo "Usage: $0 brightness <led> <0-255>" >&2
            exit 2
        }

        set_brightness "$2" "$3"
        ;;

    color)
        [ $# -eq 5 ] || {
            echo "Usage: $0 color <led> <R> <G> <B>" >&2
            exit 2
        }

        set_color "$2" "$3" "$4" "$5"
        ;;

    blink)
        [ $# -eq 4 ] || {
            echo "Usage: $0 blink <led> <on_ms> <off_ms>" >&2
            exit 2
        }

        set_blink "$2" "$3" "$4"
        ;;

    breath)
        [ $# -eq 4 ] || {
            echo "Usage: $0 breath <led> <on_ms> <off_ms>" >&2
            exit 2
        }

        set_breath "$2" "$3" "$4"
        ;;

    stop)
        [ $# -eq 2 ] || {
            echo "Usage: $0 stop <led>" >&2
            exit 2
        }

        stop_effect "$2"
        ;;

    trigger)
        [ $# -eq 3 ] || {
            echo "Usage: $0 trigger <led> <trigger>" >&2
            exit 2
        }

        set_trigger "$2" "$3"
        ;;

    help|--help|-h)
        usage
        ;;

    *)
        echo "ERROR: Unknown command '$1'." >&2
        usage
        exit 2
        ;;
esac
