#!/bin/bash
#
# UGREEN LED Control
# Backend for UGREEN NAS LED Class driver
#

set -u

LED_BASE="/sys/class/leds"

SUPPORTED_LEDS="power netdev disk1 disk2 disk3 disk4 disk5 disk6 disk7 disk8"

usage() {
    cat <<USAGE
UGREEN LED Control

Usage:
  ugreen-leds status
  ugreen-leds list
  ugreen-leds get <led>
  ugreen-leds on <led>
  ugreen-leds off <led>
  ugreen-leds brightness <led> <0-255>
  ugreen-leds color <led> <R> <G> <B>
  ugreen-leds blink <led> <on_ms> <off_ms>
  ugreen-leds breath <led> <on_ms> <off_ms>
  ugreen-leds stop <led>
  ugreen-leds trigger <led> <trigger>
  ugreen-leds help

Supported LEDs:
  power
  netdev
  disk1 ... disk8
USAGE
}

valid_led() {
    local led="$1"
    [ -d "$LED_BASE/$led" ]
}

read_attr() {
    local led="$1"
    local attr="$2"
    local file="$LED_BASE/$led/$attr"

    if [ -r "$file" ]; then
        cat "$file" 2>/dev/null
    else
        echo ""
    fi
}

write_attr() {
    local led="$1"
    local attr="$2"
    local value="$3"
    local file="$LED_BASE/$led/$attr"

    if [ ! -e "$file" ]; then
        echo "ERROR: Attribute '$attr' is not available for '$led'." >&2
        return 1
    fi

    if [ ! -w "$file" ]; then
        echo "ERROR: Attribute '$attr' is not writable for '$led'." >&2
        return 1
    fi

    printf '%s\n' "$value" > "$file"
}

list_leds() {
    echo "["

    local first=1
    local led

    for led in $SUPPORTED_LEDS; do
        if valid_led "$led"; then
            if [ "$first" -eq 0 ]; then
                echo ","
            fi

            printf '  "%s"' "$led"
            first=0
        fi
    done

    echo
    echo "]"
}

get_status() {
    local led="$1"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    local brightness
    local max_brightness
    local color
    local trigger
    local status
    local device_name

    brightness="$(read_attr "$led" brightness)"
    max_brightness="$(read_attr "$led" max_brightness)"
    color="$(read_attr "$led" color)"
    trigger="$(read_attr "$led" trigger)"
    status="$(read_attr "$led" status)"
    device_name="$(read_attr "$led" device_name)"

    printf '{\n'
    printf '  "name": "%s",\n' "$led"
    printf '  "brightness": "%s",\n' "$brightness"
    printf '  "max_brightness": "%s",\n' "$max_brightness"
    printf '  "color": "%s",\n' "$color"
    printf '  "trigger": "%s",\n' "$trigger"
    printf '  "status": "%s",\n' "$status"
    printf '  "device_name": "%s"\n' "${device_name:-N/A}"
    printf '}\n'
}

status() {
    printf '{\n'
    printf '  "ok": true,\n'
    printf '  "model": "UGREEN DXP 6800 Pro",\n'
    printf '  "controller": "led_ugreen",\n'
    printf '  "i2c_bus": 0,\n'
    printf '  "i2c_address": "0x3a",\n'
    printf '  "leds": '

    list_leds

    printf '}\n'
}

set_on() {
    local led="$1"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" trigger "none" 2>/dev/null || true
    write_attr "$led" brightness 255
}

set_off() {
    local led="$1"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" trigger "none" 2>/dev/null || true
    write_attr "$led" brightness 0
}

set_brightness() {
    local led="$1"
    local value="$2"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    case "$value" in
        ''|*[!0-9]*)
            echo "ERROR: Brightness must be between 0 and 255." >&2
            return 1
            ;;
    esac

    if [ "$value" -gt 255 ]; then
        echo "ERROR: Brightness must be between 0 and 255." >&2
        return 1
    fi

    write_attr "$led" trigger "none" 2>/dev/null || true
    write_attr "$led" brightness "$value"
}

set_color() {
    local led="$1"
    local r="$2"
    local g="$3"
    local b="$4"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    for value in "$r" "$g" "$b"; do
        case "$value" in
            ''|*[!0-9]*)
                echo "ERROR: RGB values must be between 0 and 255." >&2
                return 1
                ;;
        esac

        if [ "$value" -gt 255 ]; then
            echo "ERROR: RGB values must be between 0 and 255." >&2
            return 1
        fi
    done

    write_attr "$led" color "$r $g $b"
}

set_blink() {
    local led="$1"
    local on_ms="$2"
    local off_ms="$3"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" trigger "none" 2>/dev/null || true
    write_attr "$led" blink_type "blink $on_ms $off_ms"
}

set_breath() {
    local led="$1"
    local on_ms="$2"
    local off_ms="$3"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" trigger "none" 2>/dev/null || true
    write_attr "$led" blink_type "breath $on_ms $off_ms"
}

stop_effect() {
    local led="$1"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" blink_type "none" 2>/dev/null || true
    write_attr "$led" trigger "none" 2>/dev/null || true
}

set_trigger() {
    local led="$1"
    local trigger="$2"

    valid_led "$led" || {
        echo "ERROR: LED '$led' not found." >&2
        return 1
    }

    write_attr "$led" trigger "$trigger"
}

case "${1:-help}" in

    status)
        status
        ;;

    list)
        list_leds
        ;;

    get)
        [ $# -eq 2 ] || {
            echo "Usage: $0 get <led>" >&2
            exit 2
        }

        get_status "$2"
        ;;

    on)
        [ $# -eq 2 ] || {
            echo "Usage: $0 on <led>" >&2
            exit 2
        }

        set_on "$2"
        ;;

    off)
        [ $# -eq 2 ] || {
            echo "Usage: $0 off <led>" >&2
            exit 2
        }

        set_off "$2"
        ;;

    brightness)
        [ $# -eq 3 ] || {
            echo "Usage: $0 brightness <led> <0-255>" >&2
            exit 2
        }

        set_brightness "$2" "$3"
        ;;

    color)
        [ $# -eq 5 ] || {
            echo "Usage: $0 color <led> <R> <G> <B>" >&2
            exit 2
        }

        set_color "$2" "$3" "$4" "$5"
        ;;

    blink)
        [ $# -eq 4 ] || {
            echo "Usage: $0 blink <led> <on_ms> <off_ms>" >&2
            exit 2
        }

        set_blink "$2" "$3" "$4"
        ;;

    breath)
        [ $# -eq 4 ] || {
            echo "Usage: $0 breath <led> <on_ms> <off_ms>" >&2
            exit 2
        }

        set_breath "$2" "$3" "$4"
        ;;

    stop)
        [ $# -eq 2 ] || {
            echo "Usage: $0 stop <led>" >&2
            exit 2
        }

        stop_effect "$2"
        ;;

    trigger)
        [ $# -eq 3 ] || {
            echo "Usage: $0 trigger <led> <trigger>" >&2
            exit 2
        }

        set_trigger "$2" "$3"
        ;;

    help|--help|-h)
        usage
        ;;

    *)
        echo "ERROR: Unknown command '$1'." >&2
        usage
        exit 2
        ;;
esac
