$ulc_var = is_file('/var/local/emhttp/var.ini')
    ? parse_ini_file('/var/local/emhttp/var.ini')
    : [];

$ulc_version = preg_match(
    '/ENTITY\s+version\s+"([^"]+)"/',
    (string)@file_get_contents('/boot/config/plugins/ugreen-led-control.plg'),
    $ulc_match
) ? $ulc_match[1] : 'dev';
?>

<script>
window.UGREEN_LED_CSRF_TOKEN = <?= json_encode($ulc_var['csrf_token'] ?? '') ?>;
window.UGREEN_LED_VERSION = <?= json_encode($ulc_version) ?>;
</script>

